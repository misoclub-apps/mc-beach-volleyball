{
  "name": "mc-beach-volleyball",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "update": ".venv/bin/python -m scripts.update",
    "test": "node --test tests/*.test.mjs",
    "test:python": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "playwright test"
  },
  "devDependencies": { "@playwright/test": "^1.55.0", "@axe-core/playwright": "^4.10.2" }
}
